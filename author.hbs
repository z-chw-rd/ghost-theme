{{!< default}}

<section class="gh-grid">

        {{#author}}
        <header class="gh-page-header">
            {{#if profile_image}}
                <img class="gh-author-image" src="{{profile_image}}" alt="{{name}}" />
            {{/if}}

            <h1>{{name}}</h1>
            {{#if bio}}
                <p class="body-l">{{bio}}</p>
            {{/if}}

            <div class="gh-author-meta">
                <div class="gh-author-links">
                    {{#if website}}
                        <a href="{{website}}" target="_blank" rel="noopener">Website</a>
                    {{/if}}
                </div>
            </div>

            {{#if cover_image}}
                <img class="gh-page-image" src="{{cover_image}}" alt="{{name}}" />
            {{/if}}
        </header>
        {{/author}}

        <ul class="gh-content-feed-vstack">
            {{#foreach posts}}

                {{> "content-feed-item-vstack" page=../pagination.page }} {{!-- partials/content-feed-item-row.hbs --}}

            {{/foreach}}
        </ul>

</section>
